generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Book {
  id        BigInt     @id @default(autoincrement())
  title     String
  author    String?
  genre     String?
  synopsis  String?
  favorites Favorite[]

  @@map("books")
}

model Favorite {
  book_id BigInt?
  f_id    BigInt  @id @default(autoincrement())
  books   Book?   @relation(fields: [book_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@map("favorites")
}
