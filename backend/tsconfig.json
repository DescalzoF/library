{
  "compilerOptions": {
    // --- Layout ---
    "rootDir": ".",                 // incluye src, tests y setup.ts
    "outDir": "./dist",

    // --- Runtime: Node ESM ---
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",

    // --- Tipos y libs ---
    "lib": ["ES2022"],
    "types": ["node", "jest"],

    // --- Interop / imports ---
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,

    // --- Output extra (opcional) ---
    "sourceMap": true,
    "declaration": true,
    "declarationMap": true,

    // --- Checks / estilo ---
    "strict": true,
    "skipLibCheck": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "moduleDetection": "force",

    // Claves para evitar TS1295 con imports ESM en .ts
    "verbatimModuleSyntax": false,

    // ts-jest compila archivo por archivo; mejor desactivar esto aquí
    "isolatedModules": false
  },
  "include": ["src", "setup.ts", "**/*.ts"],
  "exclude": ["node_modules"]
}
